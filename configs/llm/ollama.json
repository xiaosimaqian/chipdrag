{
    "name": "ollama_llm",
    "version": "1.0.0",
    "description": "Ollama LLM 配置",
    
    "models": {
        "default": {
            "name": "deepseek-coder:latest",
            "base_url": "http://localhost:11434",
            "temperature": 0.7,
            "max_tokens": 800,
            "top_p": 0.9,
            "top_k": 40,
            "repetition_penalty": 1.1,
            "stop_sequences": ["", "Human:", "Assistant:"],
            "context_window": 8192,
            "timeout": 300,
            "retry_attempts": 2,
            "retry_delay": 5
        },
        "code": {
            "name": "deepseek-coder:latest",
            "base_url": "http://localhost:11434",
            "temperature": 0.2,
            "max_tokens": 2000,
            "top_p": 0.95,
            "top_k": 50,
            "repetition_penalty": 1.2,
            "stop_sequences": ["", "Human:", "Assistant:", "```"],
            "context_window": 8192,
            "timeout": 300,
            "retry_attempts": 2,
            "retry_delay": 5
        },
        "layout": {
            "name": "deepseek-coder:latest",
            "base_url": "http://localhost:11434",
            "temperature": 0.3,
            "max_tokens": 1000,
            "top_p": 0.9,
            "top_k": 40,
            "repetition_penalty": 1.1,
            "stop_sequences": ["", "Human:", "Assistant:", "```"],
            "context_window": 8192,
            "timeout": 300,
            "retry_attempts": 2,
            "retry_delay": 5
        }
    },
    
    "prompts": {
        "system": "你是一个专业的芯片布局设计助手，擅长分析电路结构并生成高质量的布局方案。",
        "code_generation": "请根据以下电路描述生成对应的布局代码：\n{circuit_description}",
        "layout_analysis": "请分析以下布局方案的质量和优化空间：\n{layout_description}",
        "constraint_check": "请检查以下布局是否满足所有约束条件：\n{constraints}\n{layout}"
    },
    
    "cache": {
        "enabled": true,
        "type": "memory",
        "max_size": 1000,
        "ttl": 3600,
        "storage_path": "cache/llm"
    },
    
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "logs/llm.log",
        "max_size": 10485760,
        "backup_count": 5
    },
    
    "monitoring": {
        "enabled": true,
        "interval": 60,
        "metrics": [
            "latency",
            "throughput",
            "error_rate",
            "token_usage"
        ],
        "alerts": [
            {
                "type": "latency",
                "threshold": 1000,
                "action": "alert"
            },
            {
                "type": "error_rate",
                "threshold": 0.01,
                "action": "alert"
            }
        ]
    },
    
    "error_handling": {
        "retry_strategy": "exponential_backoff",
        "max_retries": 2,
        "base_delay": 3,
        "max_delay": 20,
        "timeout": 300
    },
    
    "performance": {
        "batch_size": 8,
        "num_workers": 2,
        "timeout": 300,
        "cache_size": 1000,
        "concurrent_requests": 2
    }
}